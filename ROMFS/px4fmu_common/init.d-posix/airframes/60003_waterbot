param set-default WOUT_FUNC8 108   # Motor8


# ─── Thruster geometry template (CA_ROTOR*) ──────────────────────────────────
# Fill this section after confirming physical layout.
#
# Coordinate convention used by PX4 control allocation (body frame, FRD):
#   +X: forward, +Y: right, +Z: down
#
# For each rotor n:
#   Position  (PX,PY,PZ): in meters, relative to vehicle center of gravity (CG)
#   Direction (AX,AY,AZ): unit vector, positive thrust direction for positive command
#   KM: reaction torque coefficient (start with small value, then tune)
#
# Axis vector must be normalized:
#   AX^2 + AY^2 + AZ^2 = 1
# Example:
#   pure forward thrust  -> (1, 0, 0)
#   pure downward thrust -> (0, 0, 1)
#   45 deg in XY plane   -> (0.7071, 0.7071, 0)
#
# Enable steps:
# 1) Uncomment CA_ROTOR_COUNT and set thruster count (8 for this platform)
# 2) Configure CA_R_REV bitmask for reversible thrusters
# 3) Fill rotor 0..N-1 PX/PY/PZ + AX/AY/AZ + KM
# 4) Verify sign by testing each DOF one-by-one (roll/pitch/yaw/heave/surge/sway)
#
# CA_R_REV bitmask notes:
# - Bit n controls rotor n reversibility (LSB is rotor0)
# - All 8 reversible -> 255 (binary 11111111)
# - Example: only rotor0/1/2 reversible -> 7 (binary 00000111)
#
# Suggested initial KM:
# - If unknown, start with 0.00 to first validate force-direction mapping
# - Then use 0.02~0.10 as a practical initial range and tune from logs
#
# Quick self-check before first run:
# - Distances are meters (not mm)
# - Positions use CG as origin (not hull corner)
# - AX/AY/AZ follow FRD sign convention
# - Rotors with same physical direction share same axis vector signs

param set-default CA_ROTOR_COUNT 8
param set-default CA_R_REV 255

# Rotor 0 (example slot: horizontal/vector thruster)
param set-default CA_ROTOR0_PX -0.165
param set-default CA_ROTOR0_PY 0.000
param set-default CA_ROTOR0_PZ -0.040
param set-default CA_ROTOR0_AX 0.000
param set-default CA_ROTOR0_AY 0.000
param set-default CA_ROTOR0_AZ 1.000
param set-default CA_ROTOR0_KM 0.000

# Rotor 1 (example slot: horizontal/vector thruster)
param set-default CA_ROTOR1_PX -0.155
param set-default CA_ROTOR1_PY 0.020
param set-default CA_ROTOR1_PZ 0.000
param set-default CA_ROTOR1_AX 1.000
param set-default CA_ROTOR1_AY 0.000
param set-default CA_ROTOR1_AZ 0.000
param set-default CA_ROTOR1_KM 0.000

# Rotor 2 (example slot: horizontal/vector thruster)
param set-default CA_ROTOR2_PX -0.155
