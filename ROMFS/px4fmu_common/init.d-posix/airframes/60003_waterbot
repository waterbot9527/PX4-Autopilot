. ${R}/etc/init.d/rc.uuv_defaults

# ─── Vehicle type / control allocation ───────────────────────────────────────
param set-default CA_AIRFRAME 7       # MOTORS_6DOF → ActuatorEffectivenessUUV
param set-default CA_METHOD   0
param set-default MAV_TYPE    12      # MAV_TYPE_SUBMARINE

# ─── Platform: no ESC / no SD card ───────────────────────────────────────────
param set-default COM_ARM_CHK_ESCS 0
param set-default FD_ESCS_EN       0
param set-default COM_ARM_SDCARD   0

# ─── Logging ─────────────────────────────────────────────────────────────────
# SDLOG_MODE:
#   0 = 解锁后开始记录（默认）
#   1 = 开机即记录，直到加锁
#   2 = 开机即记录，直到关机（推荐水下设备使用）
param set SDLOG_MODE       2

# SDLOG_PROFILE bitmask（可叠加）:
#   bit0=1  默认主题集（传感器/执行器等基础数据）
#   bit1=2  EKF2 全速率重放主题（用于事后姿态估计分析）
#   bit5=32 调试主题（debug_*.msg，供自定义代码使用）
# 1+2+32 = 35
param set SDLOG_PROFILE    35

# 最多保留的日志目录数（超出后自动删除最旧的）
param set SDLOG_DIRS_MAX   10

# 为每条日志添加全局唯一 UUID（便于多设备区分日志文件）
param set SDLOG_UUID       1

# ─── Safety / arming ─────────────────────────────────────────────────────────
param set-default COM_RC_IN_MODE  1       # joystick only (gamepad via QGC), no RC calibration required
param set-default COM_RCL_EXCEPT   4       # ignore RC loss in Offboard mode (bit2)
param set-default COM_CPU_MAX     -1       # no CPU-load limit (Raspberry Pi)
param set-default CBRK_SUPPLY_CHK 894281  # bypass voltage check (no battery)

# ─── Manual input gains (raw manual feedthrough) ────────────────────────────
param set-default UUV_MGM_ROLL  0.5
param set-default UUV_MGM_PITCH 0.5
param set-default UUV_MGM_YAW   0.5
param set-default UUV_MGM_THRTL 0.5
param set-default UUV_TORQUE_SAT 0.5
param set-default UUV_THRUST_SAT 0.5

# ─── Magnetometer: disabled for underwater ────────────────────────────────────
param set-default EKF2_MAG_TYPE   0    # no mag fusion
param set-default COM_ARM_MAG_ANG 180
param set-default COM_ARM_MAG_STR 0

# Waterbot (UUV) EKF barometer tuning for faster convergence underwater
param set-default EKF2_BARO_GATE 100
