param set-default SDLOG_MODE       0

# ─── Safety / arming ─────────────────────────────────────────────────────────
param set-default COM_RCL_EXCEPT   4       # ignore RC loss in Offboard mode (bit2)
param set-default COM_CPU_MAX     -1       # no CPU-load limit (Raspberry Pi)
param set-default CBRK_SUPPLY_CHK 894281  # bypass voltage check (no battery)

# ─── Magnetometer: disabled for underwater ────────────────────────────────────
param set-default EKF2_MAG_TYPE   0    # no mag fusion
param set-default COM_ARM_MAG_ANG 180
param set-default COM_ARM_MAG_STR 0

# Waterbot (UUV) EKF barometer tuning for faster convergence underwater
param set-default EKF2_BARO_GATE 100
