param set-default CA_ROTOR2_AZ 0.000
param set-default CA_ROTOR2_KM 0.000

# Rotor 3 (center-mounted thruster, forward thrust)
param set-default CA_ROTOR3_PX 0.000
param set-default CA_ROTOR3_PY 0.000
param set-default CA_ROTOR3_PZ 0.000
param set-default CA_ROTOR3_AX 0.000
param set-default CA_ROTOR3_AY 0.000
param set-default CA_ROTOR3_AZ 0.000
param set-default CA_ROTOR3_KM 0.000

# Rotor 4 (front-left vertical thruster, downward thrust)
param set-default CA_ROTOR4_PX 0.140
param set-default CA_ROTOR4_PY -0.045
param set-default CA_ROTOR4_PZ 0.000
param set-default CA_ROTOR4_AX 0.000
param set-default CA_ROTOR4_AY 0.000
param set-default CA_ROTOR4_AZ 1.000
param set-default CA_ROTOR4_KM 0.000

# Rotor 5 (front-right fan thruster, forward thrust for Y-axis pitch control)
param set-default CA_ROTOR5_PX 0.140
param set-default CA_ROTOR5_PY 0.045
param set-default CA_ROTOR5_PZ 0.000
param set-default CA_ROTOR5_AX 1.000
param set-default CA_ROTOR5_AY 0.000
param set-default CA_ROTOR5_AZ 0.000
param set-default CA_ROTOR5_KM 0.000

# Rotor 6 (front-center vertical thruster, downward thrust)
param set-default CA_ROTOR6_PX 0.110
